{
  "name": "recipe-index",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1 --port 4173",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1 --port 4173",
    "data:fetch": "node scripts/fetch-source-descriptions.mjs",
    "data:rebuild": "node scripts/rebuild-data.mjs",
    "test": "node --test",
    "check": "node --test && node scripts/check.mjs && astro build",
    "deploy": "npm run build && wrangler pages deploy dist --project-name veg-protein-food --branch main --commit-hash \"$(git rev-parse HEAD)\""
  },
  "dependencies": {
    "astro": "^7.2.2"
  }
}
